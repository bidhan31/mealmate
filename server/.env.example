# ── Runtime ──────────────────────────────────────────
NODE_ENV=development
PORT=5000
TZ=Asia/Dhaka
CURRENCY=BDT

# ── Database ─────────────────────────────────────────
MONGODB_URI=mongodb+srv://<db_user>:<db_password>@<cluster-host>/?appName=<cluster-name>

# ── Auth / JWT ───────────────────────────────────────
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

# ── Google OAuth ─────────────────────────────────────
GOOGLE_CLIENT_ID=<your-google-oauth-client-id>.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=<your-google-oauth-client-secret>

# ── Email (Brevo transactional email API) ──────────────────────────────────
BREVO_API_KEY=xkeysib-<your-brevo-api-key>
# Must be a sender that is VERIFIED/ACTIVATED in your Brevo account
# (https://app.brevo.com/senders/all). Brevo rejects any other sender with
# HTTP 400 — the usual reason verification emails silently never arrive.
MAIL_FROM="MealMate <hello@mealmate.app>"

# ── Email provider selection ────────────────────────────────────────────────
# 'brevo' | 'smtp' | 'console'. Leave empty to auto-detect: Brevo key first,
# then SMTP, otherwise emails are logged to the console (development only).
MAIL_PROVIDER=

# ── SMTP provider (e.g. Gmail) ──────────────────────────────────────────────
# Fill these instead of BREVO_API_KEY to send through a normal mailbox.
# Gmail: enable 2-Step Verification, create an App Password
# (https://myaccount.google.com/apppasswords) and use it as SMTP_PASS.
# Brevo: host smtp-relay.brevo.com, port 587, login/key from SMTP & API tab.
#   SMTP_HOST=smtp-relay.brevo.com
#   SMTP_PORT=587
#   SMTP_SECURE=false
#   SMTP_USER=your-smtp-login
#   SMTP_PASS=your-smtp-key
#   MAIL_FROM="MealMate <you@yourdomain.com>"

# Easiest setup — answers a few questions, writes this file and sends a test email:
#   npm --workspace server run mail:setup

# ── Email verification policy ───────────────────────────────────────────────
# Allow login before the email address is verified.
# Leave unset: defaults to true in development/test, false in production.
# Set to true only as a temporary unblock if your mail provider is down.
ALLOW_UNVERIFIED_LOGIN=

# ── CORS / Client ────────────────────────────────────
CLIENT_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173,https://dev-mealmate.netlify.app
